{
  "name": "wordseekr",
  "private": true,
  "version": "2.16.4",
  "build": 2,
  "type": "module",
  "scripts": {
    "dev": "npm run db:sync && vite dev",
    "dev:local": "VITE_CAPACITOR_IS_LOCAL=true VITE_CAPACITOR_IS_DEV=true bun run dev",
    "dev:home": "VITE_CAPACITOR_IS_LOCAL=false VITE_CAPACITOR_IS_DEV=true bun run dev",
    "dev:mobile:local": "VITE_CAPACITOR_IS_LOCAL=true VITE_CAPACITOR_IS_DEV=true bun run mobile-sync && bun run dev",
    "dev:mobile:home": "VITE_CAPACITOR_IS_LOCAL=false VITE_CAPACITOR_IS_DEV=true bun run mobile-sync && bun run dev",
    "build": "npm run db:sql-wasm && npm run db:copy && vite build",
    "ios": "bun run build && bunx cap run ios",
    "droid": "bun run build && bunx cap run android",
    "mobile-sync": "bun run build && bunx cap sync",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:sql-wasm": "node scripts/copy-sql-wasm.js",
    "db:copy": "node scripts/copy-database.js",
    "db:sync": "npm run db:sql-wasm && npm run db:copy",
    "db:import": "node scripts/import-database.js",
    "migrate": "node scripts/run-migration.js",
    "migrate:schema": "node scripts/migrate-to-new-schema.js",
    "generate-assets": "bunx capacitor-assets generate",
    "build:ios": "bun run version:build && bun run build && bunx cap sync ios && bun run build:ios:archive",
    "build:ios:archive": "cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' -archivePath ../build/App.xcarchive archive && xcodebuild -exportArchive -archivePath ../build/App.xcarchive -exportOptionsPlist ../../ci/exportOptions.plist -exportPath ../build",
    "upload:ios:": "node scripts/ci/upload-ios.js ios/build/App.ipa G4L8LU7C98 11ce2dc0-2d90-49c8-8ca1-f086155754ae",
    "build:ios:full": "bun run build:ios && bun run upload:ios:",
    "build:droid": "bun run version:build && bun run build && bunx cap sync android && bun run build:droid:archive",
    "build:droid:archive": "export JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.7/libexec/openjdk.jdk/Contents/Home && node scripts/ci/android-build.js",
    "build:droid:archive:apk": "export JAVA_HOME=/opt/homebrew/Cellar/openjdk@21/21.0.7/libexec/openjdk.jdk/Contents/Home && node scripts/ci/android-build.js apk=true",
    "build:droid:archive:all": "bun run build:droid:archive:apk && bun run build:droid:archive",
    "upload:droid": "echo 'todo'",
    "build:mobile:full": "bun run version:build && bun run db:sync && bun run mobile-sync && bun run build:ios:archive && bun run upload:ios: && bun run build:droid:archive:all && bun run upload:droid",
    "version:build": "node scripts/update-version.js",
    "version:check": "node scripts/update-version.js --check",
    "version:major": "node scripts/update-version.js --major",
    "version:minor": "node scripts/update-version.js --minor",
    "version:patch": "node scripts/update-version.js --patch",
    "release": "build:mobile:full",
    "release:patch": "bun run version:patch && bun run build:mobile:full",
    "release:minor": "bun run version:minor && bun run build:mobile:full",
    "release:major": "bun run version:major && bun run build:mobile:full"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/svelte": "^5.2.8",
    "@types/bun": "latest",
    "@types/jest": "^29.5.14",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "svelte": "^5.37.2",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@adplorg/capacitor-in-app-purchase": "^2.0.64",
    "@capacitor-community/admob": "file:/../../../../oss/admob",
    "@capacitor-community/safe-area": "file:/../../../../forks/safe-area",
    "@capacitor-community/sqlite": "file:/../../../../forks/sqlite",
    "@capacitor-firebase/analytics": "^7.3.0",
    "@capacitor-firebase/crashlytics": "^7.3.0",
    "@capacitor-firebase/firestore": "^7.3.0",
    "@capacitor-firebase/performance": "^7.3.0",
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/local-notifications": "file:/../../../../capacitor-plugins/local-notifications",
    "@capacitor/preferences": "^7.0.1",
    "@inlang/paraglide-js": "^2.2.0",
    "@libsql/client": "^0.14.0",
    "animejs": "^4.1.2",
    "aptoide-appcoinssdk": "file:../../../../aptoide/aptoide-appcoinssdk",
    "cordova-plugin-purchase": "^13.12.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "jeep-sqlite": "^2.8.0",
    "mode-watcher": "^1.1.0",
    "prettier-plugin-curly": "^0.3.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.7",
    "svelte-confetti": "^2.3.2",
    "svelte-loading-spinners": "^0.3.6",
    "virtua": "^0.41.5"
  }
}
